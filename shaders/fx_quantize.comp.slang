// Quantizer (spec §6.4): palette lock × dither engine (§6.2). Display-
// referred by nature — the kernel converts linear -> sRGB around its core.
//
// Dither modes: 0 none, 1-3 Bayer 2/4/8, 4 white noise, 5 blue noise,
// 6 STBN (temporal slices advance on the boil clock), 7 moiré (two ordered
// patterns drifting in scale/angle), 8 level cycle (quantization levels
// rotate on the boil clock — the demoscene palette-cycling crawl),
// 9 RD stipple (the engine steps a per-instance Gray-Scott sim and binds
// its B field at binding 2). Shared controls: boil rate (pattern re-seed
// at N Hz), pattern scroll, wave-warp, and dissolve (ordered threshold
// sweep — 1 = fully quantized, sweeping to 0 reveals the input; doubles
// as a transition).
//
// Binding 1 is the packed dither LUT (512x192 R8): rows 0..63 hold the
// STBN 64x64x8 atlas (slice s at x = s*64), rows 64..191 the 128x128 blue
// noise. Generated by tools/bluenoise at build time.
//
// Palettes: 0 = RGB levels, 1 = grayscale levels, 2 = Game Boy, 3 = CGA.
// Composition: final = mix(in, blend(in, mix(in, fx(in), wet)), opacity).

#include "fx_common.slang"

[[vk::push_constant]]
cbuffer Push
{
    uint width;
    uint height;
    float wet;
    float opacity;
    uint seed;
    uint frame;
    float fps;
    float levels;      // quantization steps per channel (RGB/gray palettes)
    float palette;     // 0 rgb, 1 gray, 2 game boy, 3 cga
    float dither;      // mode, see header
    float dither_amt;  // 0..1 threshold strength
    float boil_hz;     // pattern re-seed rate; 0 = static
    float scroll;      // pattern drift, px/s
    float warp;        // wave-warp of the pattern coordinates
    float dissolve;    // ordered threshold sweep (1 = full effect)
    float lock_mode;   // 0 screen-locked, 1 motion-locked (flow advection)
    float pat_rotate;  // pattern transform: rotation, degrees
    float pat_scale;   // pattern transform: scale
    float pal_hue_a;   // custom palette hues (palette 6)
    float pal_hue_b;
};

[[vk::binding(0, 0)]] Sampler2D input;
[[vk::binding(1, 0)]] Sampler2D noise_lut;   // 512x192 R8, see header
[[vk::binding(2, 0)]] Sampler2D rd_state;    // Gray-Scott (A, B) for mode 9
[[vk::binding(3, 0)]] Sampler2D flow;        // block MVs (motion lock)
[[vk::binding(4, 0)]] RWTexture2D<float4> output;

static const float2 kLutSize = float2(512.0, 192.0);

float lut_texel(uint x, uint y)
{
    const float2 uv = (float2(float(x), float(y)) + 0.5) / kLutSize;
    return noise_lut.SampleLevel(uv, 0).r;
}

float blue_noise(uint2 p)
{
    return lut_texel(p.x & 127u, 64u + (p.y & 127u));
}

float stbn(uint2 p, uint slice)
{
    return lut_texel((slice & 7u) * 64u + (p.x & 63u), p.y & 63u);
}

static const float kBayer2[4] = {0.0, 2.0, 3.0, 1.0};
static const float kBayer4[16] = {
    0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0,
    3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0};

float bayer8(uint2 p)
{
    // 8x8 from the recursive construction over the 4x4.
    const uint2 q = p & 7;
    const float base = kBayer4[(q.y & 3) * 4 + (q.x & 3)];
    const float quad = float(((q.y >> 2) & 1) * 2 + ((q.x >> 2) & 1));
    return (base * 4.0 + kBayer2[uint(quad)]) / 64.0;
}

float3 nearest_of4(float3 c, float3 p0, float3 p1, float3 p2, float3 p3)
{
    float3 best = p0;
    float best_d = dot(c - p0, c - p0);
    float d = dot(c - p1, c - p1);
    if (d < best_d) { best_d = d; best = p1; }
    d = dot(c - p2, c - p2);
    if (d < best_d) { best_d = d; best = p2; }
    d = dot(c - p3, c - p3);
    if (d < best_d) { best_d = d; best = p3; }
    return best;
}

[shader("compute")]
[numthreads(8, 8, 1)]
void main(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= width || tid.y >= height)
        return;
    const float2 uv = (float2(tid.xy) + 0.5) / float2(width, height);
    const float4 base = input.SampleLevel(uv, 0);

    // Display-referred core.
    float3 c = fx_srgb_oetf(saturate(base.rgb));

    // Boil: the pattern re-seeds/offsets at boil_hz.
    const float t = fps > 0.0 ? float(frame) / fps : 0.0;
    const uint boil_tick = boil_hz > 0.01 ? uint(t * boil_hz) : 0u;
    const uint2 shift = uint2(fx_hash3(seed, boil_tick, 11u) & 127u,
                              fx_hash3(seed, boil_tick, 13u) & 127u);

    // Pattern coordinates: scroll drifts diagonally on the timeline clock;
    // rotate/scale are the other pattern-transform legs (spec §6.2);
    // motion lock advects the pattern along the flow field so it rides
    // the content instead of the screen; wave-warp bends the result.
    float2 pf = float2(tid.xy);
    if (lock_mode >= 0.5) {
        const float2 mv = flow.SampleLevel(uv, 0).rg;
        pf -= mv;
    }
    if (abs(pat_rotate) > 0.01) {
        const float pr = pat_rotate * 0.01745329252;
        const float prc = cos(pr), prs = sin(pr);
        pf = float2(pf.x * prc - pf.y * prs, pf.x * prs + pf.y * prc);
    }
    pf /= clamp(pat_scale, 0.25, 4.0);
    pf += float2(shift);
    pf += t * scroll * float2(1.0, 0.37);
    if (warp > 0.001) {
        pf += warp * 20.0 *
              float2(sin(pf.y * 0.043 + t * 0.9),
                     sin(pf.x * 0.037 - t * 0.7));
    }
    const uint2 p = uint2(int2(floor(pf)) & 0x7FFF);

    // Threshold pattern in [0, 1).
    const int dm = int(dither + 0.5);
    float pattern = 0.5;
    if (dm == 1)
        pattern = (kBayer2[(p.y & 1) * 2 + (p.x & 1)] + 0.5) / 4.0;
    else if (dm == 2)
        pattern = (kBayer4[(p.y & 3) * 4 + (p.x & 3)] + 0.5) / 16.0;
    else if (dm == 3)
        pattern = bayer8(p) + 0.5 / 64.0;
    else if (dm == 4)
        pattern = fx_hash01(fx_hash4(seed, boil_tick, tid.x, tid.y));
    else if (dm == 5)
        pattern = blue_noise(p);
    else if (dm == 6)
        pattern = stbn(p, boil_hz > 0.01 ? boil_tick : 0u);
    else if (dm == 7) {
        // Moiré: two ordered patterns at drifting scale/angle interfere.
        const float ang = t * 0.15;
        const float ca = cos(ang), sa = sin(ang);
        const float2 r1 = float2(pf.x * ca - pf.y * sa,
                                 pf.x * sa + pf.y * ca);
        const float2 r2 = pf * 1.09;
        const float m = bayer8(uint2(int2(floor(r1)) & 0x7FFF)) +
                        bayer8(uint2(int2(floor(r2)) & 0x7FFF));
        pattern = frac(m);
    }
    else if (dm == 9) {
        // RD stipple: the sim's B concentration (dots ~0.35, field 0).
        pattern = saturate(rd_state.SampleLevel(uv, 0).g * 2.5);
    }
    else if (dm == 10) {
        // Spiral screen: an archimedean spiral threshold wound from the
        // pattern origin (ordered-shape family, spec §6.2).
        const float2 d = pf - float2(float(width), float(height)) * 0.5;
        pattern =
            frac(length(d) * 0.125 - atan2(d.y, d.x) * 0.15915494);
    }
    else if (dm == 11) {
        // Radial rings: concentric ordered threshold.
        const float2 d = pf - float2(float(width), float(height)) * 0.5;
        pattern = frac(length(d) * 0.125);
    }
    else if (dm == 12) {
        // Diamond cluster: |dx|+|dy| ramp inside 8px cells — cluster-dot
        // ordered dithering with a diamond growth shape.
        const float2 f = frac(pf * 0.125) - 0.5;
        pattern = saturate((abs(f.x) + abs(f.y)) * 1.4);
    }
    float threshold = (pattern - 0.5) * saturate(dither_amt);
    if (dm == 0 || dm == 8) threshold = 0.0;

    // Level cycling (mode 8): rotate the quantized output levels on the
    // boil clock — bands crawl through gradients and snap around.
    const float cycle_rate = boil_hz > 0.01 ? boil_hz : 2.0;
    const uint cycle_step = dm == 8 ? uint(t * cycle_rate) : 0u;

    const int pal = int(palette + 0.5);
    const float n = max(levels, 2.0);
    float3 result;
    if (pal == 0)
    {
        float3 idx = round(saturate(c + threshold / (n - 1.0)) * (n - 1.0));
        if (cycle_step != 0u)
            idx = float3(fmod(idx.r + float(cycle_step), n),
                         fmod(idx.g + float(cycle_step), n),
                         fmod(idx.b + float(cycle_step), n));
        result = idx / (n - 1.0);
    }
    else if (pal == 1)
    {
        const float l = fx_luma(c);
        float idx = round(saturate(l + threshold / (n - 1.0)) * (n - 1.0));
        if (cycle_step != 0u) idx = fmod(idx + float(cycle_step), n);
        const float q = idx / (n - 1.0);
        result = float3(q, q, q);
    }
    else if (pal == 2)
    {
        // DMG greens, darkest to lightest. Cycling rotates the luma phase.
        float l = saturate(fx_luma(c) + threshold * 0.34);
        if (cycle_step != 0u) l = frac(l + float(cycle_step & 3u) * 0.25);
        result = nearest_of4(float3(l, l, l),
                             float3(0.059, 0.220, 0.059),
                             float3(0.188, 0.384, 0.188),
                             float3(0.545, 0.675, 0.059),
                             float3(0.608, 0.737, 0.059));
    }
    else if (pal == 3)
    {
        // CGA palette 1: black / cyan / magenta / white.
        float3 dithered = saturate(c + threshold * 0.5);
        if (cycle_step != 0u)
            dithered = frac(dithered + float(cycle_step & 3u) * 0.25);
        result = nearest_of4(dithered,
                             float3(0.0, 0.0, 0.0),
                             float3(0.333, 1.0, 1.0),
                             float3(1.0, 0.333, 1.0),
                             float3(1.0, 1.0, 1.0));
    }
    else if (pal == 4)
    {
        // NES: a representative 12-entry cut of the 2C02 palette.
        const float3 nes[12] = {
            float3(0.0, 0.0, 0.0),       float3(0.33, 0.33, 0.33),
            float3(0.74, 0.74, 0.74),    float3(1.0, 1.0, 1.0),
            float3(0.0, 0.47, 0.97),     float3(0.15, 0.15, 0.65),
            float3(0.9, 0.2, 0.16),      float3(0.65, 0.06, 0.0),
            float3(0.0, 0.66, 0.14),     float3(0.98, 0.7, 0.0),
            float3(0.96, 0.46, 0.7),     float3(0.35, 0.2, 0.7),
        };
        float3 dithered = saturate(c + threshold * 0.5);
        if (cycle_step != 0u)
            dithered = frac(dithered + float(cycle_step & 3u) * 0.25);
        float3 best = nes[0];
        float best_d = 1.0e9;
        for (int i = 0; i < 12; ++i) {
            const float d = dot(dithered - nes[i], dithered - nes[i]);
            if (d < best_d) { best_d = d; best = nes[i]; }
        }
        result = best;
    }
    else if (pal == 5)
    {
        // Teletext: the 8 fully saturated CEEFAX colors — each channel
        // snaps to 0 or 1.
        float3 dithered = saturate(c + threshold * 0.5);
        if (cycle_step != 0u)
            dithered = frac(dithered + float(cycle_step & 3u) * 0.25);
        result = round(dithered);
    }
    else
    {
        // Custom duotone ramp (spec §6.4 custom palette): black -> hue A
        // -> hue B -> white by luma, hues from the two knobs.
        float l = saturate(fx_luma(c) + threshold * 0.34);
        if (cycle_step != 0u) l = frac(l + float(cycle_step & 3u) * 0.25);
        const float3 ha = fx_hue_to_rgb(pal_hue_a);
        const float3 hb = fx_hue_to_rgb(pal_hue_b);
        result = nearest_of4(float3(l, l, l),
                             float3(0.02, 0.02, 0.02),
                             ha * 0.45,
                             hb * 0.85,
                             float3(0.98, 0.98, 0.98));
    }

    // Dissolve: ordered threshold sweep between input and quantized —
    // keyframe it 0 -> 1 and it is a dither transition (spec §6.2).
    if (dissolve < 0.999) {
        // Patternless modes (none, level cycle) gate on a hash instead.
        const float gate = (dm == 0 || dm == 8)
            ? fx_hash01(fx_hash4(seed, 3u, tid.x, tid.y))
            : pattern;
        result = gate <= dissolve ? result : c;
    }

    const float4 quantized = float4(fx_srgb_eotf(result), base.a);
    const float4 wetted = lerp(base, quantized, saturate(wet));
    output[tid.xy] = lerp(base, wetted, saturate(opacity));
}
